{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "search": {
      "type": "string",
      "maxLength": 256
    },
    "repository": {
      "type": "string",
      "maxLength": 256
    },
    "assessment": {
      "enum": [
        "",
        "updates_found",
        "no_candidate",
        "excluded",
        "unknown"
      ]
    },
    "updateType": {
      "enum": [
        "",
        "major",
        "minor",
        "patch",
        "digest",
        "pinDigest",
        "pin",
        "unknown"
      ]
    },
    "workflow": {
      "enum": [
        "",
        "pr_open",
        "branch_only",
        "none_observed",
        "unknown"
      ]
    }
  },
  "required": []
}
