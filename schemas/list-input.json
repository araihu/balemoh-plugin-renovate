{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "search": {
      "type": "string",
      "maxLength": 256
    },
    "repository": {
      "type": "string",
      "maxLength": 256
    },
    "assessment": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^((updates_found|no_candidate|excluded|unknown)(,(updates_found|no_candidate|excluded|unknown)){0,3})?$",
      "description": "Comma-separated selections, OR within this filter. Empty matches all. Duplicates are rejected."
    },
    "updateType": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^((major|minor|patch|digest|pinDigest|pin|unknown)(,(major|minor|patch|digest|pinDigest|pin|unknown)){0,6})?$",
      "description": "Comma-separated selections, OR within this filter. Empty matches all. Duplicates are rejected."
    },
    "workflow": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^((pr_open|branch_only|none_observed|unknown)(,(pr_open|branch_only|none_observed|unknown)){0,3})?$",
      "description": "Comma-separated selections, OR within this filter. Empty matches all. Duplicates are rejected."
    },
    "cursor": {
      "type": "string",
      "maxLength": 1024
    },
    "revision": {
      "type": "string",
      "maxLength": 24
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": []
}
