{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "string",
      "maxLength": 256
    },
    "updateType": {
      "enum": [
        "",
        "major",
        "minor",
        "patch",
        "digest",
        "pinDigest",
        "pin",
        "unknown"
      ],
      "type": "string",
      "maxLength": 32
    },
    "maxRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  },
  "required": []
}
