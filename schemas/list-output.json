{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "name",
        "baseBranch",
        "commit"
      ],
      "properties": {
        "platform": {
          "const": "github"
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renovateVersion",
        "renovateImage",
        "adapterVersion",
        "policyHash"
      ],
      "properties": {
        "renovateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "renovateImage": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "policyHash": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "status",
        "sourceRecords",
        "extracted",
        "assessed",
        "excluded",
        "unknown",
        "reasons"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "sourceRecords": {
          "$ref": "#/$defs/count"
        },
        "extracted": {
          "$ref": "#/$defs/count"
        },
        "assessed": {
          "$ref": "#/$defs/count"
        },
        "excluded": {
          "$ref": "#/$defs/count"
        },
        "unknown": {
          "$ref": "#/$defs/count"
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        }
      }
    },
    "completedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "lookupCauses": {
      "type": "object",
      "maxProperties": 11,
      "additionalProperties": {
        "$ref": "#/$defs/count"
      }
    },
    "assessmentBreakdown": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "updatesFound": {
          "$ref": "#/$defs/count"
        },
        "noCandidatesReported": {
          "$ref": "#/$defs/count"
        },
        "lookupUnconfirmed": {
          "$ref": "#/$defs/count"
        },
        "conflictingDeclarations": {
          "$ref": "#/$defs/count"
        },
        "otherUnknown": {
          "$ref": "#/$defs/count"
        },
        "noCandidate": {
          "$ref": "#/$defs/count"
        },
        "excluded": {
          "$ref": "#/$defs/count"
        },
        "unidentifiedRecords": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "updatesFound",
        "noCandidatesReported",
        "lookupUnconfirmed",
        "conflictingDeclarations",
        "otherUnknown",
        "noCandidate",
        "excluded",
        "unidentifiedRecords"
      ]
    },
    "snapshotDigest": {
      "$ref": "#/$defs/id"
    },
    "controllerAvailable": {
      "type": "boolean"
    },
    "controller": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generatedFingerprintFile": {
          "type": "string",
          "maxLength": 512
        },
        "enabled": {
          "type": "boolean"
        },
        "requests": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/request"
          }
        }
      },
      "required": [
        "enabled",
        "requests"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "total": {
      "$ref": "#/$defs/count"
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "nextCursor": {
      "type": "string",
      "maxLength": 1024
    }
  },
  "required": [
    "repository",
    "producer",
    "coverage",
    "completedAt",
    "lookupCauses",
    "assessmentBreakdown",
    "snapshotDigest",
    "controllerAvailable",
    "controller",
    "items",
    "total",
    "revision",
    "nextCursor"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manager",
        "packageFile",
        "dependencyKey",
        "packageName",
        "currentValue",
        "currentDigest",
        "assessment",
        "candidates",
        "reasons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "manager": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "packageFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "dependencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "registryUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "sourceOccurrences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "currentValue": {
          "$ref": "#/$defs/value"
        },
        "currentDigest": {
          "$ref": "#/$defs/digest"
        },
        "assessment": {
          "enum": [
            "updates_found",
            "no_candidate",
            "excluded",
            "unknown"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        },
        "serviceId": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment": {
                "const": "updates_found"
              }
            }
          },
          "then": {
            "properties": {
              "candidates": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "candidates": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "newValue",
        "newDigest",
        "updateType",
        "policy",
        "workflow"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "newValue": {
          "$ref": "#/$defs/value"
        },
        "newDigest": {
          "$ref": "#/$defs/digest"
        },
        "updateType": {
          "enum": [
            "major",
            "minor",
            "patch",
            "digest",
            "pinDigest",
            "pin",
            "unknown"
          ]
        },
        "policy": {
          "enum": [
            "eligible",
            "approval_required",
            "release_age",
            "pending_checks",
            "scheduled",
            "rate_limited",
            "pr_limit",
            "ignored",
            "unknown"
          ]
        },
        "workflow": {
          "enum": [
            "pr_open",
            "branch_only",
            "none_observed",
            "unknown"
          ]
        },
        "isVulnerabilityAlert": {
          "const": true,
          "description": "Explicit Renovate flag on this update or its uniquely matched native branch upgrade. Absence is unknown, not a clean security assessment."
        },
        "branchName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "branchResult": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "pr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "url",
            "headSha"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "headSha": {
              "anyOf": [
                {
                  "$ref": "#/$defs/commit"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "newValue": {
                  "type": "string"
                }
              }
            },
            {
              "properties": {
                "newDigest": {
                  "type": "string"
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": {
              "workflow": {
                "const": "pr_open"
              }
            }
          },
          "then": {
            "properties": {
              "pr": {}
            },
            "required": [
              "pr"
            ]
          },
          "else": {
            "properties": {
              "pr": false
            }
          }
        }
      ]
    },
    "request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshotDigest": {
          "$ref": "#/$defs/id"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "name",
            "baseBranch",
            "commit"
          ],
          "properties": {
            "platform": {
              "const": "github"
            },
            "name": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "baseBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "commit": {
              "$ref": "#/$defs/commit"
            }
          }
        },
        "dependency": {
          "$ref": "#/$defs/dependency"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "branch": {
          "type": "string",
          "maxLength": 256
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "awaiting_pr",
            "open",
            "draft",
            "closed",
            "merged",
            "blocked",
            "needs_attention"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        },
        "rebaseHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trackedAt": {
          "type": "string",
          "format": "date-time"
        },
        "trackingError": {
          "type": "boolean"
        },
        "pr": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "headSha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "state": {
              "enum": [
                "open",
                "draft",
                "closed",
                "merged"
              ]
            },
            "checks": {
              "enum": [
                "passing",
                "pending",
                "failing",
                "unknown"
              ]
            }
          },
          "required": [
            "number",
            "url",
            "headSha",
            "state",
            "checks"
          ]
        }
      },
      "required": [
        "id",
        "snapshotDigest",
        "repository",
        "dependency",
        "candidate",
        "branch",
        "state",
        "createdAt",
        "updatedAt",
        "trackingError"
      ]
    }
  }
}
