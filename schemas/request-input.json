{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "dependencyId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "dependencyId",
    "candidateId",
    "snapshotDigest"
  ]
}
