package view

import (
 "github.com/araihu/goshtoso/components/badge"
 "github.com/araihu/goshtoso/components/link"
)

templ ListPRStatus(m Model) {
 <div class="image-upgrades-cell">
 if r:=m.listRequest();r!=nil {
 @badge.Badge(badge.Config{Label:listRequestLabel(*r),Appearance:badge.AppearanceSoft})
 if !m.Meta.ControllerAvailable || r.TrackingError {
 <small>Tracking unavailable · last known status</small>
 } else if r.PR!=nil {
 <small>{ m.requestChecks(*r,true) }</small>
 }
 if r.TrackedAt!=nil {
 <small>Checked <time datetime={ r.TrackedAt.UTC().Format("2006-01-02T15:04:05Z07:00") }>{ r.TrackedAt.UTC().Format("15:04 UTC") }</time></small>
 }
 } else if prs:=m.reportedPRs();len(prs)>0 {
 for _,pr:=range prs {
 <span>{ "Reported PR #"+count(pr.Number) }</span>
 }
 <small>Status not verified</small>
 } else if !m.Meta.ControllerAvailable {
 <span>PR status unavailable</span>
 } else if !m.Meta.Controller.Enabled {
 <span>Requests disabled</span>
 } else {
 <span>Not requested</span>
 }
 </div>
}

templ ListActions(m Model) {
 <div class="image-upgrades-row-actions">
 if r:=m.listRequest();r!=nil {
 if r.PR!=nil {
 @link.Link(r.PR.URL,link.WithTarget("_blank"),link.WithRootClass("image-upgrades-action"),link.WithAttrs(templ.Attributes{"rel":"noopener noreferrer","aria-label":"View PR #"+count(r.PR.Number)+" for "+m.Detail.Dependency.PackageName+" in "+m.Detail.Dependency.PackageFile})){ { "View PR #"+count(r.PR.Number) } }
 } else {
 @link.Link(m.StatusURL,link.WithRootClass("image-upgrades-action")){ View request }
 }
 }
 for _,pr:=range m.reportedPRs() {
 @link.Link(pr.URL,link.WithTarget("_blank"),link.WithRootClass("image-upgrades-action"),link.WithAttrs(templ.Attributes{"rel":"noopener noreferrer","aria-label":"View reported PR #"+count(pr.Number)+" for "+m.Detail.Dependency.PackageName+" in "+m.Detail.Dependency.PackageFile})){ { "View reported PR #"+count(pr.Number) } }
 }
 for _,candidate:=range m.Detail.Dependency.Candidates {
 if m.CanReviewAgain(candidate) && m.RequestLinks[candidate.ID]!="" {
 @link.Link(m.RequestLinks[candidate.ID],link.WithRootClass("image-upgrades-action"),link.WithAttrs(templ.Attributes{"aria-label":reviewPRLabel(m.Detail.Dependency,candidate)+" for "+m.Detail.Dependency.PackageName+" in "+m.Detail.Dependency.PackageFile})){ { reviewPRLabel(m.Detail.Dependency,candidate) } }
 }
 }
 @DetailLink(m.StatusURL,m.Detail.Dependency)
 </div>
}
